  <diagram name="04  |  Identity inventory and operational ownership" id="04-operations">
    <mxGraphModel dx="2200" dy="1490" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2200" pageHeight="1490" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="text0" value="04  |  Identity inventory and operational ownership" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=32;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="40" width="2090" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="SIX UPSTREAM IDENTITIES  •  five ordinary personas + one dedicated administrator  •  passwords intentionally excluded" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#51647E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="105" width="2080" height="45" as="geometry" />
        </mxCell>
        <mxCell id="users" value="&lt;b&gt;UPSTREAM DEX PERSONAS&lt;/b&gt;&lt;br&gt;&lt;br&gt;testuser01@dda.test  •  Alex Morgan&lt;br&gt;testuser02@dda.test  •  Jamie Parker&lt;br&gt;testuser03@dda.test  •  Taylor Reed&lt;br&gt;testuser04@dda.test  •  Jordan Blake&lt;br&gt;testuser05@dda.test  •  Casey Brooks&lt;br&gt;&lt;br&gt;All five: webui-user role → ordinary app user&lt;br&gt;Stable IDs dda-test-01 … dda-test-05&lt;br&gt;Profile name/email inherited from Dex" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="65" y="230" width="660" height="390" as="geometry" />
        </mxCell>
        <mxCell id="admins" value="&lt;b&gt;DEFAULT ADMINISTRATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dex SSO identity: admin@dda.test / DDA Administrator&lt;br&gt;Keycloak dda: explicit realm-management/realm-admin&lt;br&gt;Open WebUI: openwebui-admins → webui-admin&lt;br&gt;Keycloak master: separate admin credential&lt;br&gt;PostgreSQL: postgres (internal administration only)&lt;br&gt;&lt;br&gt;Dex config: file/Git administration, no admin web UI&lt;br&gt;Headroom: loopback utility, no built-in user accounts&lt;br&gt;Existing Web UI administrators preserved" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#7146B8;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="785" y="230" width="1350" height="390" as="geometry" />
        </mxCell>
        <mxCell id="config" value="&lt;b&gt;REPRODUCIBLE SOURCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;compose.yaml + compose.identity.yaml&lt;br&gt;scripts/bootstrap.py / sync-keycloak.py&lt;br&gt;Per-component README + config templates&lt;br&gt;scripts/render-openshift.py → 27 resources&lt;br&gt;images.lock.json + derived Dockerfiles&lt;br&gt;Draw.io pages + SVG previews" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="65" y="705" width="660" height="305" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="&lt;b&gt;PRIVATE MATERIAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;.runtime/TEST-USERS.md&lt;br&gt; .runtime/ADMIN-ACCESS.md&lt;br&gt;Generated secrets and bcrypt hashes&lt;br&gt;Database dumps / app backups&lt;br&gt;Rendered OpenShift Secret files&lt;br&gt;&lt;br&gt;Excluded from Git; protect/encrypt for transfer" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFF9ED;strokeColor=#A15C00;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="785" y="705" width="620" height="305" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="&lt;b&gt;DEMONSTRATED / VERIFIED&lt;/b&gt;&lt;br&gt;&lt;br&gt;Direct login for all five identities&lt;br&gt;Fresh administrator provisioned without profile form&lt;br&gt;Web UI Admin Panel + Keycloak realm console SSO&lt;br&gt;Five ordinary users remain non-admin&lt;br&gt;Invalid redirect URI rejected&lt;br&gt;Backup completed; services restarted" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F0FAF5;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1465" y="705" width="670" height="305" as="geometry" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;ENTERPRISE HANDOFF BOUNDARIES&lt;/b&gt;&lt;br&gt;&lt;br&gt;The Mac stack is running and tested. OpenShift manifests are rendered/checked, not cluster-validated.&lt;br&gt;No HA claim: SQLite stores and single PostgreSQL require a supported shared-storage/database design before scaling.&lt;br&gt;Model-provider access is independent: enterprise inference URL, CA, model artifacts and egress must be supplied.&lt;br&gt;Replace demo passwords with an approved enterprise identity source, named MFA admins, audit retention and a rotation process.&lt;br&gt;Production release requires your platform, network, certificate, capacity, restore and security acceptance evidence." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFF9ED;strokeColor=#A15C00;strokeWidth=2;fontFamily=Helvetica;fontSize=19;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="65" y="1100" width="2070" height="275" as="geometry" />
        </mxCell>
      </root>
