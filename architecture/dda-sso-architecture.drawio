  <diagram name="02  |  Seamless SSO and administrator authorization" id="02-sso">
    <mxGraphModel dx="2200" dy="1710" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2200" pageHeight="1710" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="text0" value="02  |  Seamless SSO and administrator authorization" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=32;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="40" width="2090" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="BROWSER FRONT CHANNEL + VERIFIED SERVER BACK CHANNELS  •  authorization code flow  •  no password relay to Web UI" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#51647E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="105" width="2090" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;BROWSER&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EAF0F9;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="65" y="195" width="470" height="65" as="geometry" />
        </mxCell>
        <mxCell id="w" value="&lt;b&gt;OPEN WEBUI&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EAF0F9;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="595" y="195" width="470" height="65" as="geometry" />
        </mxCell>
        <mxCell id="k" value="&lt;b&gt;KEYCLOAK / dda&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EAF0F9;strokeColor=#7146B8;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1125" y="195" width="470" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;DEX / local&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EAF0F9;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1655" y="195" width="470" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Begin SSO&lt;/b&gt;&lt;br&gt;&lt;br&gt;/oauth/oidc/login&lt;br&gt;State + nonce + PKCE challenge&lt;br&gt;kc_idp_hint=dex" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="65" y="310" width="470" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Authorize at Keycloak&lt;/b&gt;&lt;br&gt;&lt;br&gt;/realms/dda/protocol/openid-connect/auth&lt;br&gt;Client: open-webui&lt;br&gt;Exact registered Web UI callback" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1125" y="310" width="470" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Direct upstream login&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dex /dex/auth/local/login&lt;br&gt;Email + password entered only here&lt;br&gt;No Keycloak selection page" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#087E8B;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1655" y="515" width="470" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Dex → Keycloak callback&lt;/b&gt;&lt;br&gt;&lt;br&gt;/realms/dda/broker/dex/endpoint&lt;br&gt;Code exchanged at Dex /token&lt;br&gt;Broker client: keycloak-dda" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1125" y="720" width="470" height="155" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Validate and provision&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dex issuer + JWKS signature checked&lt;br&gt;Stable federated subject maps identity&lt;br&gt;Complete profile imported / FORCE sync&lt;br&gt;Unique-user flow; collisions fail" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1125" y="930" width="470" height="185" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Keycloak → Web UI callback&lt;/b&gt;&lt;br&gt;&lt;br&gt;/oauth/oidc/callback&lt;br&gt;Web UI redeems authorization code&lt;br&gt;Client secret + PKCE verifier&lt;br&gt;Validates Keycloak token / claims" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="595" y="1170" width="470" height="185" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. Application session&lt;/b&gt;&lt;br&gt;&lt;br&gt;Signed-in user lands in Open WebUI&lt;br&gt;No second profile/details form&lt;br&gt;Second Keycloak app reuses SSO" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
