        <mxCell id="dexclaims" value="&lt;b&gt;AUTHORITATIVE PROFILE&lt;/b&gt;&lt;br&gt;&lt;br&gt;email: testuser01@dda.test&lt;br&gt;name: Alex Morgan&lt;br&gt;Stable subject: test identity ID&lt;br&gt;Admin: admin@dda.test&lt;br&gt;No client secret exposed to browser" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EFFBFB;strokeColor=#087E8B;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1655" y="945" width="470" height="245" as="geometry" />
        </mxCell>
        <mxCell id="trust" value="&lt;b&gt;TWO CONFIDENTIAL CLIENTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dex client: keycloak-dda&lt;br&gt;Keycloak client: open-webui&lt;br&gt;Independent generated secrets&lt;br&gt;Strict issuer / signature validation&lt;br&gt;No password/direct grant on app client" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFF9ED;strokeColor=#A15C00;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="65" y="565" width="470" height="250" as="geometry" />
