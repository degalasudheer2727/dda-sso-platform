  <diagram name="03  |  Air-gapped OpenShift deployment reference" id="03-openshift">
    <mxGraphModel dx="2400" dy="1720" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="1720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="text0" value="03  |  Air-gapped OpenShift deployment reference" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=32;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="40" width="2290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="GENERATED REFERENCE — NOT DEPLOYED TO A CLUSTER  •  Replace registry, DNS domain, storage class and CA placeholders" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#A15C00;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="105" width="2290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="band2" value="&lt;b&gt;CONNECTED BUILD / CONTROLLED TRANSFER&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EAF0F9;strokeColor=#AFC0D4;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="45" y="180" width="485" height="1435" as="geometry" />
        </mxCell>
        <mxCell id="build" value="&lt;b&gt;APPROVED BUILD WORKSTATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pinned Dex and PostgreSQL images&lt;br&gt;Keycloak optimized production image&lt;br&gt;Open WebUI arbitrary-UID derivative&lt;br&gt;No runtime pip / npm / Maven pulls&lt;br&gt;Match target CPU architecture" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="435" height="245" as="geometry" />
        </mxCell>
        <mxCell id="archive" value="&lt;b&gt;OFFLINE IMAGE BUNDLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;docker save → dda-images.tar&lt;br&gt;Transfer archive + SHA256 checksum&lt;br&gt;Transfer repository + oc / Podman&lt;br&gt;Keep credentials out of image layers&lt;br&gt;Scan / SBOM / sign final images" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="70" y="565" width="435" height="245" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="&lt;b&gt;INTERNAL REGISTRY&lt;/b&gt;&lt;br&gt;&lt;br&gt;registry.&amp;lt;enterprise&amp;gt;/dda&lt;br&gt;Import/tag/push with Podman&lt;br&gt;Record destination manifest digests&lt;br&gt;Configure pull secret and registry CA" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#7146B8;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="70" y="875" width="435" height="205" as="geometry" />
        </mxCell>
        <mxCell id="accept" value="&lt;b&gt;PRODUCTION ACCEPTANCE GATES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Actual OpenShift version / SCC admission&lt;br&gt;PVC provisioning and restore drill&lt;br&gt;TLS trust + Route hairpin DNS&lt;br&gt;NetworkPolicy / ingress topology&lt;br&gt;HA design + load/failure tests&lt;br&gt;Real IdP MFA / user lifecycle&lt;br&gt;Approved internal LLM + RAG tests" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFF9ED;strokeColor=#A15C00;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="70" y="1140" width="435" height="365" as="geometry" />
        </mxCell>
        <mxCell id="band7" value="&lt;b&gt;ENTERPRISE OPENSHIFT CLUSTER  •  namespace dda-sso  •  restricted SCC&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EAF0F9;strokeColor=#AFC0D4;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="580" y="180" width="1760" height="1435" as="geometry" />
        </mxCell>
        <mxCell id="route" value="&lt;b&gt;HTTPS INGRESS ROUTES&lt;/b&gt;&lt;br&gt;&lt;br&gt;webui.&amp;lt;domain&amp;gt;  •  keycloak.&amp;lt;domain&amp;gt;  •  dex.&amp;lt;domain&amp;gt;&lt;br&gt;Edge TLS termination; HTTP redirected to HTTPS&lt;br&gt;Trusted ingress CA in browsers and OIDC back channels&lt;br&gt;Use re-encrypt Routes + pod certificates if full in-cluster TLS is required" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EDF4FF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="625" y="260" width="1665" height="175" as="geometry" />
        </mxCell>
        <mxCell id="ow" value="&lt;b&gt;OPEN WEBUI DEPLOYMENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Derived v0.11.3 image&lt;br&gt;Service port 8080&lt;br&gt;OAuth code + PKCE / role claims&lt;br&gt;Direct Dex provider hint&lt;br&gt;Offline downloads/version checks OFF&lt;br&gt;Separate bootstrap admin Secret" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="625" y="540" width="490" height="270" as="geometry" />
        </mxCell>
        <mxCell id="kc" value="&lt;b&gt;KEYCLOAK DEPLOYMENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Optimized 26.7.3 image&lt;br&gt;start --optimized --import-realm&lt;br&gt;Service 8080; management 9000&lt;br&gt;KC_HOSTNAME=https://keycloak…&lt;br&gt;xforwarded behind trusted router&lt;br&gt;Realm import only on first DB boot" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#7146B8;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1210" y="540" width="490" height="270" as="geometry" />
        </mxCell>
        <mxCell id="dx" value="&lt;b&gt;DEX DEPLOYMENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pinned v2.45.1 image&lt;br&gt;Service 5556; health 5558&lt;br&gt;https://dex.&amp;lt;domain&amp;gt;/dex&lt;br&gt;Config mounted from a Secret&lt;br&gt;Demo profiles explicitly opt-in&lt;br&gt;Replace with enterprise connector" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#087E8B;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1795" y="540" width="490" height="270" as="geometry" />
        </mxCell>
        <mxCell id="wv" value="&lt;b&gt;WEB UI PVC&lt;/b&gt;&lt;br&gt;&lt;br&gt;10 Gi RWO /app/backend/data&lt;br&gt;SQLite + files → ONE replica&lt;br&gt;Recreate strategy" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F0FAF5;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="625" y="935" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;POSTGRESQL DEPLOYMENT + PVC&lt;/b&gt;&lt;br&gt;&lt;br&gt;SCLorg PostgreSQL 16&lt;br&gt;Internal Service 5432&lt;br&gt;10 Gi RWO /var/lib/pgsql/data&lt;br&gt;keycloak app role / postgres DBA" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F0FAF5;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1210" y="920" width="490" height="205" as="geometry" />
        </mxCell>
        <mxCell id="dv" value="&lt;b&gt;DEX PVC&lt;/b&gt;&lt;br&gt;&lt;br&gt;1 Gi RWO /var/dex&lt;br&gt;SQLite signing/session state&lt;br&gt;ONE replica / Recreate" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F0FAF5;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1795" y="935" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="security" value="&lt;b&gt;SECURITY &amp;amp; NETWORK POLICIES&lt;/b&gt;&lt;br&gt;&lt;br&gt;No fixed UID, privileged mode, hostPath or anyuid SCC&lt;br&gt;runAsNonRoot; drop ALL; no privilege escalation; RuntimeDefault seccomp&lt;br&gt;Default deny → explicit ingress-router, DNS, Keycloak-to-DB paths&lt;br&gt;OIDC Route HTTPS egress: narrow to your actual VIPs/CIDRs&lt;br&gt;Separate generated client/database/admin Secrets; no secret values in Git" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFF9ED;strokeColor=#A15C00;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="625" y="1195" width="1010" height="290" as="geometry" />
        </mxCell>
        <mxCell id="ops" value="&lt;b&gt;RUNTIME OPERATIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Startup / readiness / liveness probes&lt;br&gt;Resource requests and memory limits&lt;br&gt;No public health/DB admin ports&lt;br&gt;Central audit / monitoring integration&lt;br&gt;Storage snapshots + logical DB backups&lt;br&gt;Single-replica reference is NOT HA&lt;br&gt;HA storage design before scaling" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F0FAF5;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
