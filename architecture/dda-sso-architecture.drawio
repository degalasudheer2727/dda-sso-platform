  <diagram name="01  |  Deployed Mac architecture" id="01-local">
    <mxGraphModel dx="2200" dy="1500" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="text0" value="01  |  Deployed Mac architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=32;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="40" width="2090" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="RUNNING LOCALLY  •  Intel Mac / Docker Desktop  •  Direct Dex login through Keycloak brokerage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#18794E;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="105" width="2050" height="40" as="geometry" />
        </mxCell>
        <mxCell id="band2" value="&lt;b&gt;HOST / BROWSER&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EAF0F9;strokeColor=#AFC0D4;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="45" y="170" width="380" height="780" as="geometry" />
        </mxCell>
        <mxCell id="band3" value="&lt;b&gt;DOCKER NETWORK  openwebui_default  •  named DNS aliases  •  persistent containers&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EAF0F9;strokeColor=#AFC0D4;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="470" y="170" width="1240" height="810" as="geometry" />
        </mxCell>
        <mxCell id="band4" value="&lt;b&gt;SOURCE &amp;amp; OPERATIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EAF0F9;strokeColor=#AFC0D4;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1750" y="170" width="405" height="1245" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;User and administrator browser&lt;/b&gt;&lt;br&gt;&lt;br&gt;Web UI: webui.localhost:3000&lt;br&gt;Click “Continue with DDA SSO”&lt;br&gt;Dex username-or-email login&lt;br&gt;No second profile form&lt;br&gt;Existing Keycloak session enables SSO" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="65" y="245" width="340" height="245" as="geometry" />
        </mxCell>
        <mxCell id="dns" value="&lt;b&gt;Local address boundary&lt;/b&gt;&lt;br&gt;&lt;br&gt;*.localhost resolves to loopback&lt;br&gt;Docker aliases use identical names&lt;br&gt;Host ports bind 127.0.0.1 only&lt;br&gt;Local HTTP is a demo exception&lt;br&gt;Issuer names must match everywhere" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFF9ED;strokeColor=#A15C00;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="65" y="555" width="340" height="245" as="geometry" />
        </mxCell>
        <mxCell id="webui" value="&lt;b&gt;OPEN WEBUI  v0.11.3&lt;/b&gt;&lt;br&gt;&lt;br&gt;Container: open-webui&lt;br&gt;Host 3000 → container 8080&lt;br&gt;Client ID: open-webui&lt;br&gt;Issuer: Keycloak /realms/dda&lt;br&gt;OIDC code + PKCE S256&lt;br&gt;Roles: webui-user / webui-admin" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="500" y="270" width="350" height="255" as="geometry" />
        </mxCell>
        <mxCell id="kc" value="&lt;b&gt;KEYCLOAK  26.7.3&lt;/b&gt;&lt;br&gt;&lt;br&gt;Container: dda-keycloak&lt;br&gt;Host/container port 8080&lt;br&gt;Realm: dda | broker alias: dex&lt;br&gt;Confidential broker client&lt;br&gt;JWKS + issuer validation&lt;br&gt;No review-profile / no auto-link" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#7146B8;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="920" y="270" width="350" height="255" as="geometry" />
        </mxCell>
        <mxCell id="dex" value="&lt;b&gt;DEX  v2.45.1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Container: dda-dex&lt;br&gt;Host/container port 5556&lt;br&gt;Issuer: /dex&lt;br&gt;5 fully populated test profiles&lt;br&gt;1 dedicated admin identity&lt;br&gt;bcrypt local passwords" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#087E8B;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1340" y="270" width="340" height="255" as="geometry" />
        </mxCell>
        <mxCell id="webvol" value="&lt;b&gt;EXISTING APP DATA&lt;/b&gt;&lt;br&gt;&lt;br&gt;External volume: open-webui&lt;br&gt;Mount: /app/backend/data&lt;br&gt;SQLite, accounts, chats, uploads&lt;br&gt;Original administrator retained" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F0FAF5;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="500" y="720" width="350" height="175" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="&lt;b&gt;POSTGRESQL  16&lt;/b&gt;&lt;br&gt;&lt;br&gt;Container: dda-keycloak-db&lt;br&gt;Internal port 5432 only&lt;br&gt;Database / app role: keycloak&lt;br&gt;Separate postgres administrator" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="920" y="625" width="350" height="175" as="geometry" />
        </mxCell>
        <mxCell id="pgvol" value="&lt;b&gt;DATABASE VOLUME&lt;/b&gt;&lt;br&gt;&lt;br&gt;openwebui_keycloak-db-data&lt;br&gt;Mount: /var/lib/pgsql/data&lt;br&gt;Realm, broker links, roles, sessions" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F0FAF5;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="920" y="825" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="dexvol" value="&lt;b&gt;DEX STATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Volume: openwebui_dex-data&lt;br&gt;Mount: /var/dex&lt;br&gt;SQLite: dex.db&lt;br&gt;Signing keys and session state" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F0FAF5;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1340" y="720" width="340" height="175" as="geometry" />
        </mxCell>
        <mxCell id="git" value="&lt;b&gt;LOCAL GIT REPOSITORY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Per-component folders + READMEs&lt;br&gt;Compose + bootstrap generators&lt;br&gt;27 native OpenShift resources&lt;br&gt;Editable Draw.io + SVG diagrams&lt;br&gt;Verification scripts / screenshots" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1775" y="240" width="355" height="245" as="geometry" />
        </mxCell>
        <mxCell id="private" value="&lt;b&gt;PRIVATE RUNTIME STATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;.runtime/secrets.json&lt;br&gt;TEST-USERS.md / ADMIN-ACCESS.md&lt;br&gt;Client / database / admin secrets&lt;br&gt;Excluded from Git&lt;br&gt;No credentials in this diagram" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFF9ED;strokeColor=#A15C00;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1775" y="525" width="355" height="225" as="geometry" />
        </mxCell>
        <mxCell id="backup" value="&lt;b&gt;BACKUP &amp;amp; OFFLINE TRANSFER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quiesce SQLite writers&lt;br&gt;pg_dump + Dex / Web UI copies&lt;br&gt;Restore requires separate drill&lt;br&gt;6.3 GB class Docker image archive&lt;br&gt;SHA256 checksum + image lock" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F0FAF5;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1775" y="790" width="355" height="240" as="geometry" />
        </mxCell>
        <mxCell id="validation" value="&lt;b&gt;VERIFIED LOCALLY&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 direct user logins + admin login&lt;br&gt;Admin Panel + realm-admin SSO&lt;br&gt;Ordinary users remain non-admin&lt;br&gt;Invalid OAuth redirect rejected&lt;br&gt;Restart persistence and backup&lt;br&gt;Open WebUI arbitrary UID healthy" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1775" y="1070" width="355" height="285" as="geometry" />
        </mxCell>
        <mxCell id="band18" value="&lt;b&gt;INDEPENDENT DEVELOPER UTILITY  •  not in the SSO trust chain&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#EAF0F9;strokeColor=#AFC0D4;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="45" y="1005" width="1665" height="410" as="geometry" />
        </mxCell>
        <mxCell id="codex" value="&lt;b&gt;CODEX ON THE MAC&lt;/b&gt;&lt;br&gt;&lt;br&gt;Existing ChatGPT authentication&lt;br&gt;User config routes model requests&lt;br&gt;MCP retrieves compressed originals" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#1764C0;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="75" y="1100" width="410" height="180" as="geometry" />
        </mxCell>
        <mxCell id="headroom" value="&lt;b&gt;HEADROOM  v0.27.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;headroom-proxy: localhost:8787&lt;br&gt;HTTP / WebSocket token compression&lt;br&gt;Loopback dashboard; no user admin&lt;br&gt;Separate headroom-data volume" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#087E8B;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="625" y="1100" width="430" height="200" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="&lt;b&gt;UPSTREAM LLM SERVICE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Codex traffic forwarded upstream&lt;br&gt;Independent of Web UI SSO&lt;br&gt;Enterprise Web UI inference endpoint&lt;br&gt;must be configured separately" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#7146B8;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1195" y="1100" width="470" height="200" as="geometry" />
        </mxCell>
