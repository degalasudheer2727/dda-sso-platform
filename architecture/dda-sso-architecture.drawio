        <mxCell id="roles" value="&lt;b&gt;EXPLICIT AUTHORIZATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;openweb-users → webui-user → user&lt;br&gt;openwebui-admins → webui-admin → admin&lt;br&gt;Admin also: realm-management/realm-admin&lt;br&gt;Master admin remains separate&lt;br&gt;No email-based automatic account merge" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#F0FAF5;strokeColor=#18794E;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="65" y="865" width="1000" height="235" as="geometry" />
        </mxCell>
        <mxCell id="session" value="&lt;b&gt;SESSION AND LOGOUT BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keycloak access token: 5 minutes • SSO idle: 30 minutes • SSO max: 8 hours&lt;br&gt;Ending the app / Keycloak session does not promise immediate revocation of every upstream session or issued JWT.&lt;br&gt;Enterprise logout, deprovisioning, MFA and expiry semantics must be validated with the actual upstream provider." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#FFF9ED;strokeColor=#A15C00;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#172B4D;" vertex="1" parent="1">
